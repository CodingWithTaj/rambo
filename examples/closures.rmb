// A closure remembers the variables around it, even after the
// function that created them has returned.
fn make_counter() {
    let count = 0;
    fn increment() {
        count += 1;
        return count;
    }
    return increment;
}

let a = make_counter();
let b = make_counter();
a(); a(); a();
b();
print("a has counted to {a()}");   // 4
print("b has counted to {b()}");   // 2

// Each loop iteration gets its own copy of the loop variable,
// so these closures each remember a different number.
let greeters = [];
for i in 0..3 {
    push(greeters, fn() { return "greeter #{i}"; });
}
for g in greeters { print(g()); }

// Functions are values: pass them in, return them, store them.
fn compose(f, g) {
    return fn(x) { return f(g(x)); };
}
let add_one = fn(x) { return x + 1; };
let double = fn(x) { return x * 2; };
print("double, then add one: {compose(add_one, double)(5)}");   // 11
